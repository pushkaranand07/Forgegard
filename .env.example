# ForgeGuard configuration. Copy to `.env` (loaded automatically) or set these
# as real environment variables; real variables take precedence.

# ── Django ───────────────────────────────────────────────────────────────────
# Local development: true. Any public deployment: false (then the key below is required).
DJANGO_DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Full origins, e.g. https://forgeguard.example.com (only needed for Django's CSRF checks on form POSTs)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# Behind a reverse proxy / PaaS router that sets X-Forwarded-Proto and X-Forwarded-For
DJANGO_BEHIND_PROXY=false
# Served over HTTPS: enables the http→https redirect, secure cookies and HSTS
DJANGO_HTTPS=false
# DJANGO_HSTS_SECONDS=2592000
# Only if every subdomain is HTTPS-only / you intend to submit to the HSTS preload list:
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_HSTS_PRELOAD=true

# ── Uploads & inference ──────────────────────────────────────────────────────
FORGEGUARD_MAX_UPLOAD_MB=100
FORGEGUARD_MAX_BATCH_FILES=20
FORGEGUARD_MAX_REQUEST_MB=500
# Background jobs: web queues, `python manage.py run_worker` analyses.
# sqlite = queue file in the spool dir (one host, works on Windows); redis = FORGEGUARD_REDIS_URL
FORGEGUARD_QUEUE_BACKEND=sqlite
# FORGEGUARD_REDIS_URL=redis://localhost:6379/0
# FORGEGUARD_SPOOL_DIR=/var/forgeguard
# Waiting jobs before new ones get 503 BUSY; how long detect endpoints wait before 202 (s)
FORGEGUARD_MAX_QUEUE=32
FORGEGUARD_SYNC_WAIT_SECONDS=20
# Jobs each worker runs at once
FORGEGUARD_MAX_CONCURRENT_INFERENCES=1
# Detection requests per client IP per minute; 0 disables
FORGEGUARD_RATE_LIMIT_PER_MINUTE=30
# Keep a copy of every analysed image in uploaded_images/ (off = analyse and discard)
FORGEGUARD_KEEP_UPLOADS=false
# FORGEGUARD_WEIGHTS_DIR=/app/weights
# FORGEGUARD_TMP_DIR=/tmp

# Rotating log file in logs/ (ignored on serverless platforms)
ENABLE_FILE_LOGGING=false

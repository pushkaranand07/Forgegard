# Django configuration
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LOG_LEVEL=INFO

# Optional threshold tuning for image calibration/detection
IMAGE_THRESHOLD_UNCERTAINTY_SHIFT=0.08
IMAGE_THRESHOLD_ARTIFACT_SHIFT=0.06
IMAGE_MIN_FAKE_THRESHOLD=0.20
IMAGE_MAX_FAKE_THRESHOLD=0.80
IMAGE_ARTIFACT_BLEND_WEIGHT=0.30

# Optional class indices (used when computing probabilities from the model)
REAL_CLASS_INDEX=1
FAKE_CLASS_INDEX=0

